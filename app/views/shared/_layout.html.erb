<!DOCTYPE html>
<html class="h-full" lang="en">
  <%= render "shared/head" do %>
    <%= yield :title %>
  <% end %>

  <body class="h-full bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-white transition-colors duration-200" data-controller="global-search">
    <!-- Background with mesh gradient and geometric grid overlay -->
    <div class="fixed inset-0 pointer-events-none"
         style="
           background: 
             radial-gradient(circle at 20% 50%, rgba(120, 119, 198, 0.3) 0%, transparent 50%),
             radial-gradient(circle at 80% 20%, rgba(255, 119, 198, 0.3) 0%, transparent 50%),
             radial-gradient(circle at 40% 80%, rgba(120, 219, 255, 0.3) 0%, transparent 50%);
           background-size: 100% 100%;
         "></div>
    
    <!-- Geometric grid overlay -->
    <div class="fixed inset-0 pointer-events-none opacity-20 dark:opacity-10"
         style="
           background-image: 
             linear-gradient(rgba(0, 0, 0, 0.1) 1px, transparent 1px),
             linear-gradient(90deg, rgba(0, 0, 0, 0.1) 1px, transparent 1px);
           background-size: 28px 28px;
         "></div>

    <div class="min-h-full flex flex-col">
      <%= render "shared/nav"%>
      <%= render "shared/toast" %>
      
      <!-- Flash messages container for Turbo Streams -->
      <div id="flash-messages" class="fixed top-4 right-4 z-50"></div>

      <div class="flex flex-col lg:flex-row flex-1">
        <!-- Sidebar (includes both desktop and mobile navigation) -->
        <%= render "shared/sidebar" %>

        <!-- Main Content -->
        <main class="flex-1 flex flex-col">
          <div class="flex-1 p-4 lg:p-6">
            <div class="<%= content_for?(:container_width) ? yield(:container_width) : 'max-w-7xl' %> mx-auto w-full px-4">
              <%= yield %>
            </div>
          </div>
          
          <%= render "shared/footer" %>
        </main>
      </div>
      
      <!-- Mobile Floating Action Button -->
      <%= render "shared/mobile_search_fab" %>
      
      <!-- Search Overlay (available globally) -->
      <%= render "shared/search_overlay" %>
    </div>
  </body>
</html>