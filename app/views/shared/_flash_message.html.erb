<%# Flash Message Component
    Used for displaying flash messages via Turbo Streams
    
    Parameters:
    - type: String - Type of message (notice, alert, error)
    - message: String - Message content to display
%>

<div
  class="<%= case type
              when 'notice' then 'bg-green-50 text-green-600'
              when 'alert', 'error' then 'bg-red-50 text-red-600'
              else 'bg-blue-50 text-blue-600'
              end %> px-4 py-3 rounded-lg shadow-lg mb-3 flex items-center transform translate-x-full opacity-0 transition-all duration-300"
  data-controller="toast"
  data-toast-target="notification"
>
  <div class="flex-1"><%= message %></div>
  <button class="ml-4 <%= case type
                          when 'notice' then 'text-green-500 hover:text-green-700'
                          when 'alert', 'error' then 'text-red-500 hover:text-red-700'
                          else 'text-blue-500 hover:text-blue-700'
                          end %>" data-action="toast#close">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>
</div>
