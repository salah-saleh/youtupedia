<%= turbo_frame_tag "audio_summary" do %>
  <div class="bg-white/35 dark:bg-gray-800/35 backdrop-blur-sm rounded-lg shadow p-4 lg:p-6 border border-gray-200 dark:border-gray-700">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
      <h3 class="text-xl lg:text-lg font-semibold text-gray-900 dark:text-white">
        Audio Summary
      </h3>
      <% unless (local_assigns[:summary] && summary[:loading]) || (local_assigns[:audio_data] && audio_data[:success]) %>
        <div class="flex gap-2 w-full sm:w-auto sm:justify-end">
          <%= form_with url: generate_audio_summary_path(video_id), 
                        method: :post, 
                        local: false,
                        data: { turbo_stream: true },
                        class: "inline" do |form| %>
            <%= form.hidden_field :voice, value: "Algenib" %>
            <%= form.submit "Create Audio Summary", 
                            class: "inline-flex w-full sm:w-auto items-center justify-center gap-2 px-3 py-2 sm:px-3 sm:py-1.5 rounded-md bg-purple-600 text-white hover:bg-purple-700 dark:bg-purple-500 dark:hover:bg-purple-600 transition-colors text-sm" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if local_assigns[:summary] && summary[:loading] %>
      <div class="animate-pulse space-y-3">
        <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-3/4"></div>
        <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-1/2"></div>
        <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-2/3"></div>
      </div>
    <% else %>
      <!-- Audio content area -->
      <div id="audio-content" class="space-y-4">
        <% if local_assigns[:audio_data] && audio_data[:success] %>
          <!-- Audio player -->
          <div class="bg-gray-50 dark:bg-gray-700 rounded-lg p-4">
            <div class="flex items-center space-x-3 mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
              </svg>
              <span class="text-sm text-gray-600 dark:text-gray-300">
                Listen to audio summary
              </span>
              <% if audio_data[:duration_seconds] && audio_data[:duration_seconds] > 0 %>
                <span class="text-sm text-gray-500 dark:text-gray-400">
                  • <%= format_duration(audio_data[:duration_seconds]) %>
                </span>
              <% end %>
            </div>
            
            <!-- Audio player controls -->
            <audio controls class="w-full" preload="metadata">
              <source src="<%= audio_data[:audio_url] %>" type="<%= audio_data[:mime_type] || 'audio/wav' %>">
              Your browser does not support the audio element.
            </audio>
            
            <!-- Download link -->
            <div class="mt-3 flex justify-end">
              <a href="<%= audio_data[:audio_url] %>" 
                 download="summary-<%= video_id %>.<%= audio_data[:mime_type]&.include?('wav') ? 'wav' : 'mp3' %>"
                 class="inline-flex items-center text-sm text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                Download Audio
              </a>
            </div>
          </div>
        <% elsif local_assigns[:audio_data] && !audio_data[:success] %>
          <!-- Error state -->
          <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4">
            <div class="flex items-center space-x-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span class="text-sm text-red-800 dark:text-red-200">
                <%= audio_data[:error] || "Failed to generate audio" %>
              </span>
            </div>
          </div>
          
          <!-- Retry button -->
          <div class="text-center">
            <%= form_with url: generate_audio_summary_path(video_id), 
                          method: :post, 
                          local: false,
                          data: { turbo_stream: true },
                          class: "inline" do |form| %>
              <%= form.hidden_field :voice, value: "Algenib" %>
              <%= form.submit "Try Again", 
                              class: "inline-flex items-center px-3 py-2 text-sm font-medium text-white bg-red-600 hover:bg-red-700 rounded-md transition-colors" %>
            <% end %>
          </div>
          
        <% else %>
          <!-- Initial state - no audio generated yet -->
          <div class="text-center">
            <p class="text-gray-600 dark:text-gray-400 mb-4">
              Convert your text summary to audio using AI-powered text-to-speech
            </p>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
